  "capability_policy": {
    "http": {
      "grant": "manifest/operation-scoped destination grant",
      "plugin_sees": "request result and opaque credential reference only",
      "plugin_does_not_see": ["raw credential", "Vault path", "arbitrary socket"],
      "enforcement": "host-side destination, credential, response-limit, and timeout checks"
    },
    "credential-use": {
      "grant": "selected credential name/reference",
      "plugin_sees": "opaque name or no credential value",
      "plugin_does_not_see": ["plaintext secret", "unrelated credentials"],
      "enforcement": "host-side injection and redaction"
    },
    "staging": {
      "grant": "invocation-scoped writable staging",
      "plugin_sees": "staged resource references",
      "plugin_does_not_see": ["Vault root", "authoritative managed path"],
      "enforcement": "host path validation, cleanup, and core promotion"
    },
    "helper": {
      "grant": "declared package-local helper name",
      "plugin_sees": "helper result",
      "plugin_does_not_see": ["arbitrary executable path", "shell authority"],
      "enforcement": "package-relative resolution and same sandbox"
    },
    "progress-logging": {
      "grant": "structured invocation events",
      "plugin_sees": "SDK event methods",
      "plugin_does_not_see": ["UI control", "authoritative state transition"],
      "enforcement": "host forwarding, redaction, and rate limits"
    }
  },
  "review": {

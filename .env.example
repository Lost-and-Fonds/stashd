ENVIRONMENT=local
BASE_URI=http://localhost:8474
STASHD_PUBLIC_URL=http://localhost:8474
STASHD_HTTP_PORT=8474
STASHD_DATA_PATH=data
STASHD_MEDIA_PATH=media
# PostgreSQL is the default. docker-compose.yml ships a matching sidecar and
# reads POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD from this file, so keep
# those in sync with the DB_* values below.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=stashd
DB_USERNAME=stashd
# Postgres is not published outside the compose network, but change this anyway.
DB_PASSWORD=stashd
POSTGRES_DB=stashd
POSTGRES_USER=stashd
POSTGRES_PASSWORD=stashd
# SQLite is still supported, and is what the `import-sqlite` role reads when
# upgrading an older install. Relative paths resolve inside STASHD_DATA_PATH.
# DB_CONNECTION=sqlite
# DB_DATABASE=stashd.sqlite
STASHD_LOG_FORMAT=text
# Comma-separated direct peer addresses allowed to supply X-Forwarded-For.
# Leave unset unless Stashd is behind a proxy you control.
# STASHD_TRUSTED_PROXY_ADDRESSES=127.0.0.1
STASHD_YTDLP_BINARY=yt-dlp
STASHD_YTDLP_TIMEOUT=600
# Optional: real downloads are on by default outside of automated tests (off
# only when ENVIRONMENT=testing). Set this to 0 to opt out, or 1 to force it
# on regardless of environment.
# STASHD_REAL_DOWNLOADS_ENABLED=
STASHD_FFMPEG_BINARY=ffmpeg
STASHD_FFMPEG_TIMEOUT=1800
# Optional: supply your own Tempest signing key (see `php tempest key:generate --no-override`).
# If left unset, Stashd generates one automatically on first boot and persists it under STASHD_DATA_PATH.
# SIGNING_KEY=
# Optional: secret used to sign Mercure hub publisher/subscriber JWTs.
# If left unset, Stashd generates one automatically on first boot and persists it under STASHD_DATA_PATH.
# MERCURE_JWT_SECRET=
YOUTUBE_DATA_API_KEY=
PUID=1000
PGID=1000
UMASK=0022
INTERNAL_CACHES=true
DISCOVERY_CACHE=partial
DEBUG_LOG_PATH=null
SERVER_LOG_PATH=null

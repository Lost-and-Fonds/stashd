{
  "name": "stashd/stashd",
  "description": "Self-hosted media preservation: Stash → Vault → Broadcasts",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-uri": "*",
    "stashd/plugin-sdk": "^0.2",
    "stashd/jellyfin": "^0.2",
    "stashd/plex": "^0.2",
    "stashd/podcast": "^0.2",
    "stashd/youtube": "^0.3",
    "tempest/framework": "^3.0",
    "symfony/process": "^7.3",
    "symfony/uid": "^7.3",
    "symfony/mercure": "^0.7.2",
    "lcobucci/jwt": "^5.6"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "laravel/pint": "^1.29",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Stashd\\PluginRuntime\\": "packages/plugin-runtime/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php ./vendor/bin/tempest install framework -f",
      "@php ./tempest discovery:generate --no-interaction",
      "@php ./tempest key:generate"
    ],
    "post-autoload-dump": [
      "@php ./tempest discovery:generate --no-interaction"
    ],
    "test": "ENVIRONMENT=testing vendor/bin/pest",
    "test:parallel": "ENVIRONMENT=testing vendor/bin/pest --parallel",
    "test:unit": "ENVIRONMENT=testing vendor/bin/pest --testsuite=Unit",
    "test:feature": "ENVIRONMENT=testing vendor/bin/pest --testsuite=Feature",
    "test:feature:parallel": "ENVIRONMENT=testing vendor/bin/pest --testsuite=Feature --parallel",
    "test:postgres": "scripts/test-postgres.sh",
    "test:docker-smoke": "tests/docker/smoke.sh",
    "test:docker-smoke:no-build": "STASHD_SMOKE_SKIP_BUILD=1 tests/docker/smoke.sh",
    "lint": [
      "composer dump-autoload --optimize --strict-psr --dry-run",
      "vendor/bin/php-cs-fixer check --diff --allow-risky=yes --config=.php-cs-fixer.dist.php",
      "vendor/bin/phpcs --standard=phpcs.xml.dist"
    ],
    "format": [
      "vendor/bin/pint",
      "vendor/bin/php-cs-fixer fix --allow-risky=yes --config=.php-cs-fixer.dist.php"
    ],
    "test:static": "vendor/bin/phpstan analyse --memory-limit=1G",
    "test:plugin-runtime": "packages/plugin-runtime/tests/run.sh"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {"type": "vcs", "url": "https://github.com/Lost-and-Fonds/plugin-api.git"},
    {"type": "vcs", "url": "https://github.com/Lost-and-Fonds/plugin-sdk.git"},
    {"type": "vcs", "url": "https://github.com/Lost-and-Fonds/jellyfin.git"},
    {"type": "vcs", "url": "https://github.com/Lost-and-Fonds/plex.git"},
    {"type": "vcs", "url": "https://github.com/Lost-and-Fonds/podcast.git"}
    ,{"type": "vcs", "url": "https://github.com/Lost-and-Fonds/youtube.git"}
  ],
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true
    }
  }
}

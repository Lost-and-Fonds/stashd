{
    "name": "stashd/stashd",
    "description": "Self-hosted media preservation: Stash \u2192 Vault \u2192 Broadcasts",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-uri": "*",
        "tempest/framework": "^3.0",
        "composer/semver": "^3.4",
        "opis/json-schema": "^2.6",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "symfony/uid": "^7.3",
        "symfony/messenger": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "doctrine/dbal": "^4.3",
        "symfony/mercure": "^0.7.2",
        "lcobucci/jwt": "^5.6"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "leafs/alchemy": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Stashd\\PluginRuntime\\": "packages/plugin-runtime/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php ./vendor/bin/tempest install framework -f",
            "@php ./tempest discovery:generate --no-interaction",
            "@php ./tempest key:generate"
        ],
        "post-autoload-dump": [
            "@php ./tempest discovery:generate --no-interaction"
        ],
        "test": "@php vendor/bin/alchemy test",
        "test:parallel": "@php vendor/bin/alchemy test --flags=parallel,processes=4",
        "test:unit": "@php vendor/bin/alchemy test --flags=testsuite=Unit",
        "test:feature": "@php vendor/bin/alchemy test --flags=testsuite=Feature",
        "test:feature:parallel": "@php vendor/bin/alchemy test --flags=testsuite=Feature,parallel,processes=4",
        "test:postgres": "@php vendor/bin/alchemy test",
        "test:docker-smoke": "tests/docker/smoke.sh",
        "test:docker-smoke:no-build": "STASHD_SMOKE_SKIP_BUILD=1 tests/docker/smoke.sh",
        "lint": "@php vendor/bin/alchemy lint",
        "format": "@php vendor/bin/alchemy fmt",
        "test:static": "@php -d memory_limit=1G vendor/bin/alchemy analyse",
        "test:plugin-runtime": "packages/plugin-runtime/tests/run.sh",
        "test:packaged": "scripts/test-packaged.sh",
        "test:naked-core": "scripts/test-naked-core.sh",
        "alchemy": "@php vendor/bin/alchemy all",
        "analyse": "@php -d memory_limit=1G vendor/bin/alchemy analyse"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [],
    "config": {
        "process-timeout": 1200,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    }
}

{
  "name": "stashd/stashd",
  "description": "Self-hosted media preservation: Stash → Vault → Broadcasts",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-uri": "*",
    "tempest/framework": "^3.0",
    "symfony/process": "^7.3",
    "symfony/uid": "^7.3",
    "symfony/mercure": "^0.7.2",
    "lcobucci/jwt": "^5.6"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "laravel/pint": "^1.29",
    "phpstan/phpstan": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Stashd\\NativeRuntime\\": "packages/native-plugin-runtime/src/"
    },
    "files": [
      "packages/plugin-sdk/src/Values.php",
      "packages/plugin-sdk/src/Errors.php",
      "packages/plugin-sdk/src/Operations.php",
      "packages/plugin-sdk/src/Input.php",
      "packages/plugin-sdk/src/Capabilities.php",
      "packages/plugin-sdk/src/Bootstrap.php",
      "packages/plugin-sdk/src/WireMapper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php ./vendor/bin/tempest install framework -f",
      "@php ./tempest discovery:generate --no-interaction",
      "@php ./tempest key:generate"
    ],
    "post-autoload-dump": [
      "@php ./tempest discovery:generate --no-interaction"
    ],
    "test": "ENVIRONMENT=testing vendor/bin/pest",
    "test:parallel": "ENVIRONMENT=testing vendor/bin/pest --parallel",
    "test:unit": "ENVIRONMENT=testing vendor/bin/pest --testsuite=Unit",
    "test:feature": "ENVIRONMENT=testing vendor/bin/pest --testsuite=Feature",
    "test:feature:parallel": "ENVIRONMENT=testing vendor/bin/pest --testsuite=Feature --parallel",
    "test:sqlite:parallel": "ENVIRONMENT=testing DB_CONNECTION=sqlite vendor/bin/pest --parallel",
    "test:postgres": "scripts/test-postgres.sh",
    "test:docker-smoke": "tests/docker/smoke.sh",
    "test:docker-smoke:no-build": "STASHD_SMOKE_SKIP_BUILD=1 tests/docker/smoke.sh",
    "test:docker-upgrade": "tests/docker/upgrade-smoke.sh",
    "test:docker-upgrade:no-build": "STASHD_SMOKE_SKIP_BUILD=1 tests/docker/upgrade-smoke.sh",
    "lint": "vendor/bin/pint --test",
    "format": "vendor/bin/pint",
    "test:static": "vendor/bin/phpstan analyse --memory-limit=1G",
    "test:native-runtime": "packages/native-plugin-runtime/tests/run.sh"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true
    }
  }
}

{
    "name": "stashd/stashd",
    "description": "Self-hosted media preservation: Stash \u2192 Vault \u2192 Broadcasts",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-uri": "*",
        "tempest/framework": "^3.0",
        "composer/semver": "^3.4",
        "opis/json-schema": "^2.6",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "symfony/uid": "^7.3",
        "symfony/messenger": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "doctrine/dbal": "^4.3",
        "symfony/mercure": "^0.7.2",
        "lcobucci/jwt": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Stashd\\PluginRuntime\\": "packages/plugin-runtime/src/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php ./vendor/bin/tempest install framework -f",
            "@php ./tempest discovery:generate --no-interaction",
            "@php ./tempest key:generate"
        ],
        "post-autoload-dump": [
            "@php ./tempest discovery:generate --no-interaction"
        ],
        "lint": [
            "@composer dump-autoload --optimize --strict-psr --dry-run",
            "@php vendor/bin/php-cs-fixer check --allow-risky=yes --config=.php-cs-fixer.dist.php"
        ],
        "format": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "analyse": "@php -d memory_limit=1G vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G --no-progress"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [],
    "config": {
        "process-timeout": 1200,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}

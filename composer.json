{
  "name": "stashd/stashd",
  "description": "Self-hosted media preservation: Stash → Vault → Broadcasts",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-uri": "*",
    "tempest/framework": "^3.0",
    "composer/semver": "^3.4",
    "opis/json-schema": "^2.6",
    "guzzlehttp/guzzle": "^7.9",
    "guzzlehttp/psr7": "^2.7",
    "symfony/process": "^7.3",
    "symfony/uid": "^7.3",
    "symfony/mercure": "^0.7.2",
    "lcobucci/jwt": "^5.6"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "laravel/pint": "^1.29",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "squizlabs/php_codesniffer": "^4.0",
    "stashd/plugin-sdk": "^0.2",
    "stashd/jellyfin": "^0.2",
    "stashd/plex": "^0.2",
    "stashd/podcast": "^0.2",
    "stashd/youtube": "^0.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Stashd\\PluginRuntime\\": "packages/plugin-runtime/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php ./vendor/bin/tempest install framework -f",
      "@php ./tempest discovery:generate --no-interaction",
      "@php ./tempest key:generate"
    ],
    "post-autoload-dump": [
      "@php ./tempest discovery:generate --no-interaction"
    ],
    "test": "./bin/test",
    "test:parallel": "./bin/test --parallel",
    "test:unit": "./bin/test --testsuite=Unit",
    "test:feature": "./bin/test --testsuite=Feature",
    "test:feature:parallel": "./bin/test --testsuite=Feature --parallel",
    "test:postgres": "scripts/test-postgres.sh",
    "test:docker-smoke": "tests/docker/smoke.sh",
    "test:docker-smoke:no-build": "STASHD_SMOKE_SKIP_BUILD=1 tests/docker/smoke.sh",
    "lint": [
      "composer dump-autoload --optimize --strict-psr --dry-run",
      "vendor/bin/php-cs-fixer check --diff --allow-risky=yes --config=.php-cs-fixer.dist.php",
      "vendor/bin/phpcs --standard=phpcs.xml.dist"
    ],
    "format": [
      "vendor/bin/pint",
      "vendor/bin/php-cs-fixer fix --allow-risky=yes --config=.php-cs-fixer.dist.php"
    ],
    "test:static": "vendor/bin/phpstan analyse --memory-limit=1G",
    "test:plugin-runtime": "packages/plugin-runtime/tests/run.sh",
    "test:packaged": "scripts/test-packaged.sh",
    "test:naked-core": "scripts/test-naked-core.sh"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {"type": "path", "url": "../plugin-api", "options": {"symlink": false, "versions": {"stashd/plugin-api": "0.1.0"}}},
    {"type": "path", "url": "../plugin-sdk", "options": {"symlink": false, "versions": {"stashd/plugin-sdk": "0.2.2"}}},
    {"type": "path", "url": "../plugins/jellyfin", "options": {"symlink": false, "versions": {"stashd/jellyfin": "0.2.0"}}},
    {"type": "path", "url": "../plugins/plex", "options": {"symlink": false, "versions": {"stashd/plex": "0.2.0"}}},
    {"type": "path", "url": "../plugins/podcast", "options": {"symlink": false, "versions": {"stashd/podcast": "0.2.0"}}},
    {"type": "path", "url": "../plugins/youtube", "options": {"symlink": false, "versions": {"stashd/youtube": "0.3.0"}}}
  ],
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true
    }
  }
}

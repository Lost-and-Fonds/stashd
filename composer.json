{
    "name": "tempest/app",
    "type": "project",
    "require": {
        "tempest/framework": "^3.0",
        "ext-intl": "*",
        "ottosmops/ocfl": "dev-fix/atomic-inventory-sidecars as 1.0.1",
        "symfony/lock": "^8.1",
        "league/uri": "^7.8",
        "symfony/uid": "^8.1",
        "doctrine/dbal": "^4.3",
        "symfony/messenger": "8.2.x-dev",
        "symfony/doctrine-messenger": "8.2.x-dev",
        "symfony/event-dispatcher": "8.2.x-dev",
        "symfony/console": "8.2.x-dev"
    },
    "require-dev": {
        "pestphp/pest": "^v5.3.2",
        "carthage-software/mago": "^1.0",
        "league/flysystem": "^3.36.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php ./vendor/bin/tempest install framework -f",
            "@php ./tempest discovery:generate --no-interaction",
            "@php ./tempest key:generate"
        ],
        "post-autoload-dump": [
            "@php ./vendor/bin/tempest discovery:generate --no-interaction"
        ],
        "fmt": "vendor/bin/mago fmt",
        "lint": "vendor/bin/mago lint --reporting-format=rich && vendor/bin/mago lint --fix --format-after-fix",
        "analyse": "vendor/bin/mago analyse",
        "audit:events": "@php tools/audit-event-catalogue.php",
        "test": "@php ./vendor/bin/pest",
        "qa": [
            "composer fmt",
            "composer lint",
            "composer analyse",
            "composer test -- --parallel --processes=8"
        ],
        "github:lint": "vendor/bin/mago lint --potentially-unsafe --minimum-fail-level=note --reporting-format=github",
        "github:fmt": "vendor/bin/mago fmt --check",
        "github:analyse": "vendor/bin/mago analyse",
        "github:test": "@test",
        "test:ready": "@php ./vendor/bin/pest --exclude-testsuite=Acceptance",
        "test:unit": "@php ./vendor/bin/pest --testsuite=Unit",
        "test:feature": "@php ./vendor/bin/pest --testsuite=Feature",
        "test:acceptance": "@php ./vendor/bin/pest --testsuite=Acceptance",
        "test:archives": "@php ./vendor/bin/pest tests/Acceptance/RecordsAndArchives",
        "test:vault": "@php ./vendor/bin/pest tests/Acceptance/RecordsAndArchives/VaultIdentityTest.php"
    },
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "carthage-software/mago": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts-descriptions": {
        "test": "Run the complete Pest suite, including unfinished acceptance contracts.",
        "test:ready": "Run Unit and Feature tests without incomplete acceptance contracts.",
        "test:unit": "Run only Unit tests.",
        "test:feature": "Run only Feature tests.",
        "test:acceptance": "Run all departmental acceptance contracts.",
        "test:archives": "Run Records & Archives acceptance contracts.",
        "test:vault": "Run Vault identity and initialization acceptance contracts."
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/hipsterjazzbo/ocfl"
        }
    ]
}

{
  "id": "plex",
  "broadcast_key": "plex",
  "name": "Plex Broadcast",
  "version": "0.1.0",
  "application_runtime": "native",
  "runtime": "php",
  "api_version": "0.1",
  "entrypoint": "plugin.php",
  "supported_file_kinds": ["video"],
  "output_path": "tvshow.nfo",
  "output_media_type": "application/xml",
  "supports_item_rebuild": true,
  "connection_setting_key": "media_server_connection_id",
  "credential": {"name": "plex-api-token", "parameter": "X-Plex-Token", "placement": "query"},
  "operations": {
    "test_connection": "test-connection",
    "list_libraries": "discover-libraries",
    "refresh_library": "refresh-library"
  },
  "ui_options": [
    {"key": "media_server_connection_id", "label": "Plex connection", "type": "text", "required": true},
    {"key": "captions", "label": "Captions", "type": "select", "default": "off", "choices": ["off", "creator_only", "creator_or_auto"]},
    {"key": "caption_languages", "label": "Caption languages", "type": "text", "default": "en"}
  ],
  "source_options": [
    {"key": "season", "label": "Season", "type": "number", "default": 1, "required": true}
  ],
  "actions": [
    {"id": "refresh-library", "label": "Refresh Plex library", "intent": "refresh_library", "operation": "refresh-library"}
  ],
  "requires": {"php": ">=8.5", "extensions": ["simplexml", "xmlwriter"]},
  "architectures": ["amd64", "arm64"]
}

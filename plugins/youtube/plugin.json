{
  "id": "youtube-component",
  "provider_key": "youtube",
  "name": "YouTube Component Input",
  "version": "0.1.0",
  "component": "plugins/youtube/target/wasm32-wasip2/release/stashd_youtube_plugin.wasm",
  "component_environment": "STASHD_PLUGIN_COMPONENT",
  "source_prefixes": [
    "https://youtube.com/",
    "https://www.youtube.com/@",
    "https://www.youtube.com/c/",
    "https://www.youtube.com/user/",
    "https://www.youtube.com/channel/",
    "https://www.youtube.com/playlist",
    "https://www.youtube.com/watch",
    "https://www.youtube.com/shorts/",
    "https://youtu.be/",
    "https://m.youtube.com/",
    "https://music.youtube.com/"
  ],
  "operations": {
    "resolve": [],
    "refresh": [],
    "complete": ["credential:youtube-data-api"],
    "acquire": ["helper:yt-dlp"]
  },
  "http_grants": [
    {
      "operations": ["resolve", "refresh"],
      "allowed_prefixes": [
        "https://www.youtube.com/@",
        "https://youtube.com/",
        "https://www.youtube.com/c/",
        "https://www.youtube.com/user/",
        "https://www.youtube.com/channel/",
        "https://m.youtube.com/",
        "https://music.youtube.com/",
        "https://www.youtube.com/feeds/videos.xml?channel_id=",
        "https://www.youtube.com/feeds/videos.xml?playlist_id=",
        "https://www.youtube.com/oembed?format=json&url="
      ]
    },
    {
      "operations": ["complete"],
      "allowed_prefixes": [
        "https://www.googleapis.com/youtube/v3/channels?",
        "https://www.googleapis.com/youtube/v3/playlists?",
        "https://www.googleapis.com/youtube/v3/playlistItems?",
        "https://www.googleapis.com/youtube/v3/videos?"
      ],
      "credential": {
        "name": "youtube-data-api",
        "secret_key": "youtube_data_api_key",
        "environment": "YOUTUBE_DATA_API_KEY",
        "query_parameter": "key"
      }
    }
  ],
  "helper": {
    "name": "yt-dlp",
    "executable_environment": "STASHD_PLUGIN_HELPER_EXECUTABLE",
    "executable": "/usr/local/bin/yt-dlp"
  },
  "input_options": [
    {"key": "include_shorts", "label": "Include Shorts", "type": "bool", "default": false, "applicable_input_types": ["channel"]},
    {"key": "include_live", "label": "Include live broadcasts and premieres", "type": "bool", "default": false, "applicable_input_types": ["channel"]},
    {"key": "include_captions", "label": "Include captions", "type": "bool", "default": false},
    {"key": "caption_languages", "label": "Caption languages", "type": "text", "default": "en"}
  ]
}

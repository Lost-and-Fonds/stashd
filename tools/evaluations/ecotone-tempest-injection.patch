--- /dev/null
+++ b/src/Config/PDO/ConfiguredPdoDriver.php
@@ -0,0 +1,67 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Ecotone\Tempest\Config\PDO;
+
+use Doctrine\DBAL\Driver;
+use Doctrine\DBAL\Driver\API\ExceptionConverter;
+use Doctrine\DBAL\Driver\Connection as DriverConnection;
+use Doctrine\DBAL\Driver\PDO\Exception;
+use Doctrine\DBAL\Platforms\AbstractPlatform;
+use Doctrine\DBAL\ServerVersionProvider;
+use PDO;
+use PDOException;
+use Tempest\Database\Config\DatabaseConfig;
+use Tempest\Database\Config\DatabaseDialect;
+
+/**
+ * Apply Tempest's original DSN and options on every physical connection.
+ *
+ * licence Apache-2.0
+ */
+final readonly class ConfiguredPdoDriver implements Driver
+{
+    private Driver $dialect;
+
+    /**
+     * Retain the native configuration without opening or caching a PDO handle.
+     */
+    public function __construct(
+        private DatabaseConfig $config,
+    ) {
+        $this->dialect = match ($config->dialect) {
+            DatabaseDialect::POSTGRESQL => new PostgresDriver(),
+            DatabaseDialect::MYSQL => new MySqlDriver(),
+            DatabaseDialect::SQLITE => new SQLiteDriver(),
+        };
+    }
+
+    /**
+     * Create a fresh PDO after DBAL closes its previous physical connection.
+     */
+    public function connect(array $params): DriverConnection
+    {
+        try {
+            return new Connection(new PDO($this->config->dsn, $this->config->username, $this->config->password, $this->config->options));
+        } catch (PDOException $error) {
+            throw Exception::new($error);
+        }
+    }
+
+    /**
+     * Use the adapter's existing dialect implementation for schema operations.
+     */
+    public function getDatabasePlatform(ServerVersionProvider $versionProvider): AbstractPlatform
+    {
+        return $this->dialect->getDatabasePlatform($versionProvider);
+    }
+
+    /**
+     * Preserve the adapter's existing conversion of native database errors.
+     */
+    public function getExceptionConverter(): ExceptionConverter
+    {
+        return $this->dialect->getExceptionConverter();
+    }
+}

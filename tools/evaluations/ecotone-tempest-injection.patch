diff --git a/src/Config/ManagedDbalConnection.php b/src/Config/ManagedDbalConnection.php
new file mode 100644
--- /dev/null
+++ b/src/Config/ManagedDbalConnection.php
@@ -0,0 +1,28 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Ecotone\Tempest\Config;
+
+use Doctrine\DBAL\Connection;
+use LogicException;
+
+/**
+ * Reject connection replacement while a shared transaction is still active.
+ *
+ * licence Apache-2.0
+ */
+final class ManagedDbalConnection extends Connection
+{
+    /**
+     * Allow physical reconnection only after both frameworks have settled their work.
+     */
+    public function close(): void
+    {
+        if ($this->isTransactionActive() || $this->isConnected() && $this->getNativeConnection()->inTransaction()) {
+            throw new LogicException('Cannot close an active shared transaction.');
+        }
+
+        parent::close();
+    }
+}
diff --git a/src/Config/PDO/ConfiguredPdoDriver.php b/src/Config/PDO/ConfiguredPdoDriver.php

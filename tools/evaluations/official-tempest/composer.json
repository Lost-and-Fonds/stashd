{
    "name": "stashd-evaluation/official-tempest",
    "type": "project",
    "require": {
        "tempest/framework": "3.19.2",
        "ext-intl": "*",
        "ottosmops/ocfl": "dev-fix/atomic-inventory-sidecars as 1.0.1",
        "symfony/lock": "^8.1",
        "league/uri": "^7.8",
        "symfony/uid": "^8.1",
        "doctrine/dbal": "^4.3",
        "symfony/event-dispatcher": "8.2.x-dev",
        "symfony/console": "8.2.x-dev",
        "ecotone/dbal": "2.0.0-beta.7",
        "ecotone/tempest": "2.0.0-beta.7"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "App\\": "../../../app/",
            "Evaluation\\Official\\": [
                "config/",
                "../../../tests/Support/Ecotone/Official/"
            ]
        }
    },
    "autoload-dev": {},
    "scripts": {},
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "carthage-software/mago": true,
            "pestphp/pest-plugin": true
        },
        "vendor-dir": "../../../tmp/official-tempest-vendor"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/hipsterjazzbo/ocfl"
        }
    ]
}

# FrankenPHP (Caddy) config for Stashd, classic (non-worker) mode.
#
# A bare ":port" address (no hostname) is HTTP-only by nature -- Caddy's
# automatic HTTPS only activates for addresses it could plausibly get a
# certificate for, so this needs no explicit `auto_https off` for the
# homelab default of a bare IP/port with no public domain.
#
# `php_server` serves anything under public/ as a static file first (built
# assets, favicon) and falls through to public/index.php otherwise -- the
# same precedence .rr.yaml's `static` middleware gave RoadRunner, without
# needing an explicit forbid list: root is scoped to public/, which never
# contains .env/.htaccess/other .php files.
:{$STASHD_HTTP_PORT:-8474} {
	root * public
	encode zstd gzip

	# Tempest-owned routes must be handled before the SPA fallback. Everything
	# else is either a real ui-v2 asset or a client-side ui-v2 route.
	@backend path /api/* /login /activity /published/* /health
	handle @backend {
		php_server
	}

	@uiAssets path /assets/*
	header @uiAssets Cache-Control "public, max-age=31536000, immutable"

	# Embedded real-time hub at /.well-known/mercure. No `anonymous`: every
	# subscriber needs a JWT minted by the authenticated
	# GET /api/v1/events/subscription endpoint. publisher_jwt/subscriber_jwt
	# share one secret -- Stashd only ever publishes to itself, so splitting
	# them would add two env vars for a distinction nothing uses.
	mercure {
		publisher_jwt {$MERCURE_JWT_SECRET}
		subscriber_jwt {$MERCURE_JWT_SECRET}
	}

	# Generic internal file serving for handlers that have already validated a
	# managed media path. The handler emits only /vault/... or /broadcasts/...
	# paths; both remain under the configured media root.
	intercept {
		@accel header X-Accel-Redirect *
		handle_response @accel {
			root {$STASHD_MEDIA_PATH:-media}
			rewrite * {resp.header.X-Accel-Redirect}
			method * GET

			# Never let the internal path leak to the client.
			header -X-Accel-Redirect

			file_server
		}
	}

	@static file
	handle @static {
		file_server
	}
	@missingAsset path_regexp \.[^/]+$
	handle @missingAsset {
		respond 404
	}

	# Vue Router history fallback for ui-v2. This block is reached only after
	# backend routes and existing files have been handled, so API errors cannot
	# become HTML 200 responses.
	handle {
		try_files {path} /index.html
		file_server
	}
}

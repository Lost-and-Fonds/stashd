<?xml version="1.0"?>
<ruleset name="Stashd PSR-1/PSR-4 structure">
    <description>
        PER-CS 3.0 formatting is enforced by PHP CS Fixer. PHPCS is limited to
        the PSR-1/PSR-4 structural contract: one named type per PSR-4 file.
    </description>

    <file>app</file>
    <file>packages</file>

    <exclude-pattern>*/tests/*</exclude-pattern>

    <rule ref="PSR1.Classes.ClassDeclaration" />
    <rule ref="PSR1.Files.SideEffects">
        <severity>0</severity>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <severity>0</severity>
    </rule>
</ruleset>

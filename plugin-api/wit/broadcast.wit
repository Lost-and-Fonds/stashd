package stashd:plugin@0.1.0;

interface broadcast-host {
    record helper-result {
        exit-code: s32,
        stdout: string,
        stderr: string,
        files: list<string>,
    }

    variant helper-error {
        denied,
        unavailable(string),
        failed(string),
    }

    record staged-artifact {
        reference: string,
        media-type: option<string>,
        size-bytes: u64,
    }

    variant staging-error {
        invalid-reference,
        missing,
        failed(string),
    }

    resource staging-area {
        run-helper: func(name: string, args: list<string>) -> result<helper-result, helper-error>;
        write: func(relative-path: string, content: list<u8>, media-type: option<string>) -> result<staged-artifact, staging-error>;
        stage: func(relative-path: string, media-type: option<string>) -> result<staged-artifact, staging-error>;
    }

    open-staging-area: func() -> staging-area;
    report-progress: func(stage: string);
    log: func(message: string);
}

interface broadcast-plugin {
    variant option-value {
        boolean(bool),
        text(string),
    }

    record setting {
        key: string,
        value: option-value,
    }

    record item-resource {
        reference: string,
        kind: string,
        derivation-key: option<string>,
        url: option<string>,
        media-type: option<string>,
        size-bytes: u64,
    }

    record item {
        id: string,
        title: string,
        description: option<string>,
        published-at: option<string>,
        duration-seconds: option<u32>,
        resources: list<item-resource>,
    }

    record publish-request {
        reference: string,
        settings: list<setting>,
        items: list<item>,
    }

    record artifact {
        reference: string,
        media-type: option<string>,
        size-bytes: u64,
    }

    record publication {
        artifact: artifact,
        published-metadata: list<setting>,
    }

    record derived-artifact {
        item-id: string,
        reference: string,
        derived-from-reference: string,
        derivation-key: string,
        kind: string,
        media-type: option<string>,
        size-bytes: u64,
    }

    record preparation {
        artifacts: list<derived-artifact>,
    }

    record error {
        message: string,
        retryable: bool,
    }

    variant plugin-error {
        unsupported(error),
        not-found(error),
        unavailable(error),
        invalid-data(error),
        failed(error),
    }

    prepare: func(request: publish-request) -> result<preparation, plugin-error>;
    publish: func(request: publish-request) -> result<publication, plugin-error>;
}

world broadcast-world {
    import broadcast-host;
    export broadcast-plugin;
}

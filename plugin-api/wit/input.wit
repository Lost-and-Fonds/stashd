package stashd:plugin@0.1.0;

interface input-host {
    record http-request {
        url: string,
        credential: option<string>,
    }

    record http-response {
        status: u16,
        body: list<u8>,
    }

    variant http-error {
        denied,
        credential-unavailable,
        authentication-rejected,
        rate-limited,
        unavailable(string),
        failed(string),
    }

    resource http-client {
        get: func(request: http-request) -> result<http-response, http-error>;
    }

    open-http-client: func() -> http-client;

    enum artifact-role {
        primary,
        captions,
        artwork,
        metadata,
    }

    record helper-result {
        exit-code: s32,
        stdout: string,
        stderr: string,
        files: list<string>,
    }

    variant helper-error {
        denied,
        unavailable(string),
        failed(string),
    }

    record staged-artifact {
        reference: string,
        role: artifact-role,
        media-type: option<string>,
        size-bytes: u64,
    }

    variant staging-error {
        invalid-reference,
        missing,
        failed(string),
    }

    resource staging-area {
        run-helper: func(name: string, args: list<string>) -> result<helper-result, helper-error>;
        stage: func(relative-path: string, role: artifact-role, media-type: option<string>) -> result<staged-artifact, staging-error>;
    }

    open-staging-area: func() -> staging-area;

    record progress {
        stage: string,
    }

    report-progress: func(progress: progress);
    log: func(message: string);
}

interface input-plugin {
    use input-host.{staged-artifact};

    enum discovery-intent {
        refresh,
        complete,
    }

    enum media-kind {
        video,
        audio,
    }

    record acquisition-options {
        media-kind: media-kind,
        include-captions: bool,
        caption-languages: option<string>,
    }

    record acquisition-result {
        artifacts: list<staged-artifact>,
    }

    record resolved-input {
        id: string,
        canonical-reference: option<string>,
        kind: option<string>,
        title: option<string>,
        artwork-reference: option<string>,
        estimated-item-count: option<u32>,
    }

    record discovered-item {
        id: string,
        reference: string,
        title: string,
        description: option<string>,
        published-at: option<string>,
        artwork-reference: option<string>,
        duration-seconds: option<u32>,
        kind: option<string>,
    }

    record error {
        message: string,
        retryable: bool,
    }

    variant plugin-error {
        unsupported(error),
        not-found(error),
        authentication(error),
        rate-limited(error),
        unavailable(error),
        invalid-data(error),
        failed(error),
    }

    resolve: func(source: string) -> result<resolved-input, plugin-error>;
    discover: func(input-id: string, intent: discovery-intent) -> result<list<discovered-item>, plugin-error>;
    acquire: func(item: discovered-item, options: acquisition-options) -> result<acquisition-result, plugin-error>;
}

world input-world {
    import input-host;
    export input-plugin;
}
